/-
Aroform — формальное ядро aro-discovery (фаза 2 по FOUNDATION §13).
v0 — проверка компиляции + миниатюра toy-судьи: базовые свойства
z*(β, Y) = max (β - Y) 0. Ядро (2–3 центральные теоремы) выбирается
из выживших узлов blueprint, не предзаказывается.

v1 (2026-09-20) — первая формализованная теорема из выжившей гипотезы
`conj-ldr-exactness` (трек B): точность аффинных правил в одномерном
случае. Атакующая выверка: judges/numerical/hunt.py, пространство oned
(20 инстансов, полное перечисление) — контрпримеров нет; доказательство
ниже покрывает весь класс, а не только перечисленное.
-/

import Mathlib

theorem toy_z_nonneg (β Y : ℚ) : 0 ≤ max (β - Y) 0 :=
  le_max_right _ _

theorem toy_z_zero_of_le (β Y : ℚ) (h : β ≤ Y) : max (β - Y) 0 = 0 :=
  max_eq_right (by linarith)

theorem toy_z_sub_of_gt (β Y : ℚ) (h : Y < β) : max (β - Y) 0 = β - Y :=
  max_eq_left (by linarith)

/-! ## Принцип монотонности гарантированной оценки (узел `thm-info-monotone`)

Формальное ядро моста ОГУ-ARO: гарантированная оценка функционала определяется
как инфимум по множеству допустимых стратегий; расширение множества допустимых
стратегий (в применении — добавление момента замыкания / стадии рекурса, т.е.
переход к более богатой информационной структуре) не может увеличить инфимум.
Отсюда немедленно: OC-граница (пустое множество замыканий) доминирует все
промежуточные RO-оценки, а те доминируют DP-границу (полная обратная связь).
-/

/-- Принцип: инфимум по подмножеству не меньше инфимума по всему множеству.
Значения — в ℝ≥0∞: гарантированная стоимость неотрицательна, +∞ допускает
недостижимость. -/
theorem info_value_monotone {S T : Set ENNReal} (hST : S ⊆ T) : sInf T ≤ sInf S :=
  le_sInf fun x hx => sInf_le (hST hx)

/-! ## Декомпозиция L1 для двумерного моста (узел `thm-l1-decomp`)

Поворот координат s = x₁ + x₂, d = x₁ − x₂ превращает L1-норму в максимум:
это ключ к замкнутой форме двумерного моста. В этих координатах управление с
выровненным B входит только в s, а разнознаковые возмущения — только в d;
d не зависит от политики и информации, поэтому при e₁ = −e₂ лестница плоская,
а при e₁ = e₂ задача сводится к скалярной с удвоенными коэффициентами.
-/

/-- Тождество поворота: L1-норма пары равна максимуму модулей суммы и
разности координат. -/
theorem l1_eq_max_sum_diff (a b : ℚ) :
    |a| + |b| = max |a + b| |a - b| := by
  simp only [abs_eq_max_neg, max_def]
  repeat' split
  all_goals linarith

/-! ## Одномерная точность аффинных правил

Сеть: одна строка рекурса (W = (1)), скалярный y ≥ 0, неопределённость
ζ ∈ [0,1], потребность аффинна: r ζ = (1 - ζ) * a + ζ * b, где a = r 0,
b = r 1 (аффинная функция определяется концами). Для фиксированной первой
стадии настраиваемый оптимум есть max (max a 0) (max b 0); хордовая
политика Y0 = max a 0, Y1 = max b 0 - max a 0 допустима и достигает его,
а ниже опуститься нельзя: значения любой допустимой аффинной политики на
концах уже мажорируют точечные оптимумы. Значит, в этом классе оптимальное
аффинное решающее правило совпадает с точным настраиваемым оптимумом.
-/

/-- Хорда точечных оптимумов мажорирует спрос и неотрицательна
(выпуклость s ↦ max s 0 вдоль отрезка). -/
theorem chord_dominates (a b ζ : ℚ) (h0 : 0 ≤ ζ) (h1 : ζ ≤ 1) :
    max ((1 - ζ) * a + ζ * b) 0 ≤ (1 - ζ) * max a 0 + ζ * max b 0 := by
  have hz0 : 0 ≤ 1 - ζ := by linarith
  have h2 : 0 ≤ (1 - ζ) * max a 0 + ζ * max b 0 :=
    add_nonneg (mul_nonneg hz0 (le_max_right a 0)) (mul_nonneg h0 (le_max_right b 0))
  have h1a : (1 - ζ) * a ≤ (1 - ζ) * max a 0 :=
    mul_le_mul_of_nonneg_left (le_max_left a 0) hz0
  have h1b : ζ * b ≤ ζ * max b 0 := mul_le_mul_of_nonneg_left (le_max_left b 0) h0
  refine max_le ?_ h2
  linarith

/-- Максимум хорды по отрезку достигается на концах. -/
theorem chord_cost_bound (A B ζ : ℚ) (h0 : 0 ≤ ζ) (h1 : ζ ≤ 1) :
    (1 - ζ) * A + ζ * B ≤ max A B := by
  rcases le_or_gt A B with h | h
  · have hle : (1 - ζ) * A ≤ (1 - ζ) * B := mul_le_mul_of_nonneg_left h (by linarith)
    linarith [le_max_right A B]
  · have hle : ζ * B ≤ ζ * A := mul_le_mul_of_nonneg_left (le_of_lt h) h0
    linarith [le_max_left A B]

/-- Никакая аффинная политика не дешевле настраиваемого оптимума: её
значения в концах отрезка уже мажорируют точечные оптимумы. -/
theorem one_d_policy_lower (a b Y0 Y1 : ℚ)
    (h0 : max a 0 ≤ Y0) (h1 : max b 0 ≤ Y0 + Y1) :
    max (max a 0) (max b 0) ≤ max Y0 (Y0 + Y1) := by
  have hM : 0 ≤ max Y0 (Y0 + Y1) :=
    le_trans (le_trans (le_max_right a 0) h0) (le_max_left _ _)
  exact max_le
    (max_le (le_trans (le_trans (le_max_left a 0) h0) (le_max_left _ _)) hM)
    (le_trans h1 (le_max_right _ _))

/-- Первая несущая теорема ядра (узел `thm-ldr-1d`): в одномерном случае
оптимальное аффинное решающее правило совпадает с точным настраиваемым
оптимумом. Первая часть — хордовая политика допустима, неотрицательна и её
гарантированная стоимость равна настраиваемому оптимуму; вторая — дешевле
не бывает. -/
theorem one_d_exactness (a b : ℚ) :
    (∃ Y0 Y1 : ℚ, ∀ ζ : ℚ, 0 ≤ ζ → ζ ≤ 1 →
        max ((1 - ζ) * a + ζ * b) 0 ≤ Y0 + Y1 * ζ
        ∧ 0 ≤ Y0 + Y1 * ζ
        ∧ Y0 + Y1 * ζ ≤ max (max a 0) (max b 0))
    ∧ ∀ Y0 Y1 : ℚ, (∀ ζ : ℚ, 0 ≤ ζ → ζ ≤ 1 →
        max ((1 - ζ) * a + ζ * b) 0 ≤ Y0 + Y1 * ζ
        ∧ 0 ≤ Y0 + Y1 * ζ) →
      max (max a 0) (max b 0) ≤ max Y0 (Y0 + Y1) := by
  constructor
  · refine ⟨max a 0, max b 0 - max a 0, ?_⟩
    intro ζ h0 h1
    have hrw : max a 0 + (max b 0 - max a 0) * ζ
        = (1 - ζ) * max a 0 + ζ * max b 0 := by ring
    have hcd := chord_dominates a b ζ h0 h1
    have hcb := chord_cost_bound (max a 0) (max b 0) ζ h0 h1
    have hz0 : 0 ≤ 1 - ζ := by linarith
    have hnn : 0 ≤ (1 - ζ) * max a 0 + ζ * max b 0 :=
      add_nonneg (mul_nonneg hz0 (le_max_right a 0)) (mul_nonneg h0 (le_max_right b 0))
    constructor
    · rw [hrw]; exact hcd
    · rw [hrw]; exact ⟨hnn, hcb⟩
  · intro Y0 Y1 hf
    have e0 := hf 0 (by norm_num) (by norm_num)
    have e1 := hf 1 (by norm_num) (by norm_num)
    exact one_d_policy_lower a b Y0 Y1 (by simpa using e0.1) (by simpa using e1.1)

/-! ## 2D-разложение: следствия E-согласования (bd 51y, драфт-сессия)

Определения компонент гарантии мост-класса: скалярная (нулевая настройка,
сумма амплитуд) и разностная (амплитуда разнознаковой части спроса).
Следствия E-согласования: при e1 = e2 разностная компонента вырождается
(задача скалярная), при e2 = -e1 разностная компонента удваивает
модуль амплитуды (лестница плоская по R в пределах разностной части).
Доказательства элементарны; целевая теорема
V(R) = max (V_scalar, V_diff) с ограничениями L2a/L2b - в драфте
TwoDDraft.lean (вне lake-цели до доказательства).
-/

/-- Скалярная компонента гарантии 2D-моста: нулевая настройка. -/
def V_scalar (d0 e1 e2 T : ℚ) : ℚ := |d0| + |e1 + e2| * T

/-- Разностная компонента гарантии 2D-моста: амплитуда разнознаковой части. -/
def V_diff (d0 e1 e2 T : ℚ) : ℚ := |d0| + |e1 - e2| * T

/-- E-согласование (e1 = e2): разностная компонента вырождается в |d0| —
лестница плоская в разностной части (наблюдение атаки BT-1: 45 плоских
лестниц). -/
theorem V_diff_aligned (d0 e1 e2 T : ℚ) (h : e1 = e2) :
    V_diff d0 e1 e2 T = |d0| := by
  subst h; simp [V_diff]

/-- E-анти-согласование (e2 = -e1): разностная компонента равна
|d0| + 2*|e1|*T — максимальная чувствительность к горизонту. -/
theorem V_diff_opposite (d0 e1 e2 T : ℚ) (h : e2 = -e1) :
    V_diff d0 e1 e2 T = |d0| + 2 * |e1| * T := by
  subst h
  simp only [V_diff, sub_neg_eq_add]
  have h2 : e1 + e1 = 2 * e1 := by ring
  rw [h2, abs_mul]
  have h2n : |(2:ℚ)| = 2 := by norm_num
  rw [h2n]

/-! ## Ядро L2a 2D-разложения (bd 51y, драфт-сессия 2026-09-24)

Разностная координата мост-класса: d_T = d0 + Δe·S, где S — сумма
возмущений пути (S = ±T на крайних путях). Два крайних пути дают в
точности |d0| + |Δe|·T — это нижняя граница разностной компоненты
2D-разложения V(R) ≥ max(V_scalar, V_diff), ядро L2a. Та же лемма
с a = s0 + (план управления) даёт суммарную границу ≥ 2·|e|·T.
Остаток L2a: поднять до V(R) через формализацию стратегий (V_R);
верхняя граница L2b — центрирующая конструкция управления.
-/

/-- Ядро L2a (разностная координата): два крайних пути S = ±T дают
гарантию ровно |d0| + |v|·T (алгебраически — лемма поворота). -/
theorem l2a_diff_two_path (d0 v T : ℚ) (hT : 0 ≤ T) :
    max |d0 + v * T| |d0 - v * T| = |d0| + |v| * T := by
  have h1 := l1_eq_max_sum_diff d0 (v * T)
  have h2 : |v| * T = |v * T| := by rw [abs_mul, abs_of_nonneg hT]
  rw [h2]
  exact h1.symm

/-- Ядро L2a (суммарная координата): при любом плане управления два
крайних пути накрывают |a| + 2·|e|·T; минимум по плану достигается
центрированием a = 0, давая скалярную компоненту 2·|e|·T. -/
theorem l2a_sum_two_path (a e T : ℚ) (hT : 0 ≤ T) :
    max |a + 2 * e * T| |a - 2 * e * T| = |a| + 2 * |e| * T := by
  have h2 : |2 * e * T| = 2 * |e| * T := by
    rw [abs_mul, abs_mul, abs_of_nonneg hT]
    norm_num
  rw [← h2]
  exact (l1_eq_max_sum_diff a (2 * e * T)).symm
